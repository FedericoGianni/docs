[global]
ioengine=psync
direct=1
bs=1M
size=512M
runtime=20
time_based=1
group_reporting=1
stonewall

[seq-read]
rw=read
filename=bench-seqread

[seq-write]
rw=write
filename=bench-seqwrite

[rand-read]
rw=randread
bs=4k
filename=bench-randread

[rand-write]
rw=randwrite
bs=4k
filename=bench-randwrite
